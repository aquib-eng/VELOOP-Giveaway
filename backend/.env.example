# ==========================================
# VELOOP GIVEAWAY - BACKEND ENVIRONMENT
# ==========================================

# Server
PORT=5000

# Environment
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=your_mongodb_atlas_connection_string

# JWT Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Device Security
DEVICE_HASH_SECRET=your_device_hash_secret

# Winner Prize Claim
WINNER_CLAIM_DAYS=7